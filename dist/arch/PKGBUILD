# Maintainer: James Beddek <telans@posteo.de>
pkgname=qnetstats
_pkgname=QNetStats
pkgver=2.0.0.alpha
pkgrel=1
pkgdesc="Network interface and statistics viewer"
arch=('x86_64')
url="https://github.com/birdie-github/QNetStats"
license=('GPL-2')
depends=(
    'qt6-base'
)
makedepends=(
    'cmake'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/birdie-github/QNetStats/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -S "$_pkgname-$pkgver" \
        -DCMAKE_BUILD_TYPE='None' \
        -DCMAKE_INSTALL_PREFIX='/usr' \
        -DUSE_QT=6 \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
